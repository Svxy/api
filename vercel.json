{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/wakatime.js", "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "api/uptime.js", "use": "@vercel/node" },
    { "src": "api/whoami.js", "use": "@vercel/node" },
    { "src": "api/sea-of-thieves.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/v1", "dest": "/api/index.js" },
    { "src": "/v1/uptime", "dest": "/api/uptime.js" },
    { "src": "/v1/health", "dest": "/api/health.js" },
    { "src": "/v1/whoami", "dest": "/api/whoami.js" },
    { "src": "/v1/wakafetch", "dest": "/api/wakatime.js" },
    { "src": "/v1/sea-of-thieves", "dest": "/api/sea-of-thieves.js" }
  ],  "redirects": [
    {
      "source": "/",
      "destination": "/v1",
      "permanent": true
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "22"
    }
  }
}